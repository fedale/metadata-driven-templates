<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title is not null ? title ~ ' · ' : '' }}metadata-driven templates</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%232f5d50'/%3E%3Cpath d='M4 5h8M4 8h8M4 11h5' stroke='white' stroke-width='1.6'/%3E%3C/svg%3E">
    <meta name="description" content="{% block description %}Ready-made models for metadata-driven: objects, forms, views, translations and data, installed in one command.{% endblock %}">
    <style>
        :root {
            --bg: #fbfaf7; --surface: #ffffff; --text: #1d1f23; --muted: #5d6470; --line: #e3e1da;
            --accent: #2f5d50; --accent-soft: #e5efe9; --warn: #8a4b0f; --warn-soft: #fbeedd; --code: #f2f0ea;
            color-scheme: light;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #15171a; --surface: #1c1f23; --text: #e8e6e1; --muted: #9aa1ab; --line: #2e3238;
                --accent: #8cc7b2; --accent-soft: #1f3530; --warn: #f0b77a; --warn-soft: #3a2a17; --code: #24282d;
                color-scheme: dark;
            }
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
        a { color: var(--accent); }
        header.site, main, footer.site { max-width: 960px; margin: 0 auto; padding: 0 16px; }
        header.site { display: flex; align-items: baseline; gap: 12px; padding-top: 24px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
        header.site a { color: var(--text); text-decoration: none; font-weight: 650; }
        header.site span { color: var(--muted); font-size: 14px; }
        main { padding-top: 24px; padding-bottom: 48px; }
        footer.site { color: var(--muted); font-size: 14px; padding-bottom: 32px; }
        h1 { font-size: 30px; line-height: 1.2; margin: 0 0 8px; }
        h2 { font-size: 20px; margin: 36px 0 12px; }
        h3 { font-size: 16px; margin: 20px 0 8px; }
        .lead { color: var(--muted); margin: 0 0 20px; max-width: 70ch; }
        code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; }
        code { background: var(--code); padding: 1px 5px; border-radius: 4px; }
        pre { background: var(--code); padding: 12px 14px; border-radius: 8px; overflow-x: auto; }
        pre code { background: none; padding: 0; }
        .badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; padding: 0; list-style: none; }
        .badge { font-size: 13px; padding: 2px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
        .badge.warn { background: var(--warn-soft); color: var(--warn); }
        .table-wrap { overflow-x: auto; }
        table { border-collapse: collapse; width: 100%; font-size: 15px; }
        th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
        th { color: var(--muted); font-weight: 600; font-size: 13px; }
        table.fields { table-layout: fixed; min-width: 560px; }
        table.fields th:nth-child(1) { width: 26%; } table.fields th:nth-child(2) { width: 28%; }
        table.fields th:nth-child(3) { width: 28%; } table.fields th:nth-child(4) { width: 18%; }
        td.flags { color: var(--muted); font-size: 13px; white-space: nowrap; }
        .hash { font-size: 12px; color: var(--muted); word-break: break-all; }
        .card { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin: 0 0 12px; color: inherit; text-decoration: none; }
        .card:hover { border-color: var(--accent); }
        .card strong { font-size: 17px; }
        .card .name { color: var(--muted); font-size: 14px; margin-left: 6px; }
        .card p { margin: 6px 0 0; color: var(--muted); }
        input[type=search] { width: 100%; font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--text); margin: 0 0 16px; }
        .readme { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 4px 20px; }
        .readme img { max-width: 100%; }
        [hidden] { display: none !important; }
    </style>
</head>
<body>
<header class="site">
    <a href="{{ root }}">metadata-driven templates</a>
    <span>the central catalog</span>
</header>
<main>
{% block body %}{% endblock %}
</main>
<footer class="site">
    Every template is reviewed before it is listed. Sources, publishing guide and index:
    <a href="https://github.com/fedale/metadata-driven-templates">fedale/metadata-driven-templates</a>
    · <a href="{{ root }}index.json">index.json</a> · <a href="{{ root }}search.json">search.json</a>
</footer>
</body>
</html>
