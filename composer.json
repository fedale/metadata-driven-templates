{
    "name": "fedale/metadata-driven-templates",
    "type": "project",
    "description": "The central catalog of metadata-driven templates: their sources, and the tools that check and publish them",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "fedale/template-format": "^1.1",
        "league/commonmark": "^2.7",
        "symfony/console": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/process": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fedale\\TemplateCatalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedale\\TemplateCatalog\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/catalog"],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": ["@cs", "@phpstan", "@test"]
    }
}
