#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fedale\TemplateCatalog\CatalogBuilder;
use Fedale\TemplateCatalog\Command\BuildCommand;
use Fedale\TemplateCatalog\Command\CheckCommand;
use Fedale\TemplateCatalog\PullRequestCheck;
use Fedale\TemplateCatalog\Site\SiteBuilder;
use Fedale\TemplateFormat\Archive;
use Fedale\TemplateFormat\DocumentCodec;
use Fedale\TemplateFormat\FieldTypes\FieldTypeCatalog;
use Fedale\TemplateFormat\PackageChecker;
use Fedale\TemplateFormat\PackageDirectory;
use Fedale\TemplateFormat\SchemaValidator;
use Fedale\TemplateFormat\SeedRecords;
use Fedale\TemplateFormat\Versions\ItemStates;
use Symfony\Component\Console\Application;

require dirname(__DIR__).'/vendor/autoload.php';

$reader = new PackageDirectory(new DocumentCodec());
$checker = new PackageChecker(new SchemaValidator(), new FieldTypeCatalog(), new SeedRecords());

$application = new Application('metadata-driven template catalog');
$application->addCommand(new CheckCommand(new PullRequestCheck($reader, $checker, new ItemStates(new FieldTypeCatalog()))));
$application->addCommand(new BuildCommand(new CatalogBuilder($reader, $checker, new Archive(), new SiteBuilder(new SeedRecords()))));
$application->run();
